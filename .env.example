DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/twingface"
NEXTAUTH_SECRET="generate-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# NEXT_PUBLIC_* values are included in browser JavaScript and are not secrets.
# Use short-lived TURN credentials; never put private API keys in NEXT_PUBLIC_*.
# WebRTC TURN relay (REQUIRED for calls across different networks — e.g.
# localhost <-> ngrok, mobile data <-> wifi). STUN alone only works when both
# sides are on the same open network. Free options: Cloudflare Calls, Metered.ca
# (free tier), or any coturn server. All three must be set together.
NEXT_PUBLIC_TURN_URL="turn:your-turn-host:3478?transport=udp,turn:your-turn-host:3478?transport=tcp"
NEXT_PUBLIC_TURN_USERNAME="your-turn-username"
NEXT_PUBLIC_TURN_CREDENTIAL="your-turn-credential"
# Password for the Super Admin account created by `npm run db:seed:super-admin`.
# Never commit a real value — keep it in your local .env only.
# Requirements: at least 8 characters, with a lowercase letter, an uppercase
# letter, and a number. Surrounding whitespace is trimmed by the seed script.
# Run `npm run db:verify:super-admin` to confirm this value matches the
# account stored in your database.
SUPER_ADMIN_PASSWORD="change-me-strong-password"
MEDIAWORLD_SEED_PASSWORD="change-me-strong-password"
